{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "bambu_lan (GTK3)",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "configure-linux-gtk3",
            "toolArgs": [
                "--dart-define=FLUTTER_LINUX_GTK=gtk3"
            ],
            "env": {
                "FLUTTER_LINUX_GTK": "gtk3"
            }
        },
        {
            "name": "bambu_lan (GTK4)",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "configure-linux-gtk4",
            "customTool": "/mnt/ssd-dev/git/flutter-gtk4/bin/flutter",
            "toolArgs": [
                "--local-engine=host_debug_unopt",
                "--local-engine-host=host_debug_unopt",
                "--local-engine-src-path=/mnt/ssd-dev/git/flutter-gtk4/engine/src",
                "--linux-gtk=gtk4",
                "--dart-define=FLUTTER_LINUX_GTK=gtk4"
            ],
            "env": {
                "FLUTTER_LINUX_GTK": "gtk4",
                "MEDIA_KIT_GTK4_DEBUG": "1"
            }
        },

        {
            "name": "bambu_lan",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "configure-linux-gtk3",
            "toolArgs": [
                "--dart-define=FLUTTER_LINUX_GTK=gtk3"
            ],
            "env": {
                "FLUTTER_LINUX_GTK": "gtk3"
            }
        },
        {
            "name": "bambu_lan (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "bambu_lan (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
